# HubSpot Private App Token
# Configurar en Netlify: Site settings > Environment variables
# Obtener en HubSpot: Settings > Integrations > Private Apps > [tu app] > Auth
# Scopes mínimos requeridos:
#   - crm.objects.contacts.write
#   - crm.objects.companies.write
#   - crm.objects.associations.write
HUBSPOT_PRIVATE_APP_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Cloudflare Turnstile — Secret Key (server-side, NUNCA al cliente)
# Configurar en Netlify: Site settings > Environment variables
# Obtener en dash.cloudflare.com > Turnstile > [tu site] > Secret Key
TURNSTILE_SECRET_KEY=0x4AAAAAAA__________________________________

# Catalysis CRM — alta de leads del formulario (app/api/external/v1/leads)
# Configurar en Netlify: Site settings > Environment variables
# CRM_API_KEY se genera en el repo catalysis-crm con:
#   node --env-file=.env.local scripts/create-api-key.mjs "sitio-web-contacto" leads:create
# CRM_LEADS_ENDPOINT: URL del endpoint /api/external/v1/leads del CRM interno de
# Catalysis (repo catalysis-crm, dominio propio del CRM). No se escribe el valor
# literal aquí a propósito: Netlify marca como "secreto filtrado" cualquier string
# del repo que coincida con el valor configurado de una env var del sitio, aunque
# no sea sensible, y eso rompe el build (deploy_validations_report / secret scan).
CRM_LEADS_ENDPOINT=https://tu-dominio-crm.example/api/external/v1/leads
CRM_API_KEY=crmk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
